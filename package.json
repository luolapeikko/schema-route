{
  "name": "@luolapeikko/schema-route",
  "version": "0.0.1",
  "description": "Utility to help building client and backend routes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean --tsconfig tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "biome check",
    "validate": "tsc --noEmit"
  },
  "keywords": ["schema", "route", "typescript", "api", "client", "backend", "validation"],
  "repository": "github:luolapeikko/schema-route",
  "author": "luolapeikko",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@luolapeikko/express-standard-schema": "^0.0.14",
    "@standard-schema/spec": "^1.1.0",
    "@tsconfig/node24": "^24.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "c8": "^12.0.0",
    "express": "^5.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
